<Window x:Class="ALGIA.Cabinet.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ALGIA Cabinet Launcher"
        Height="790"
        Width="1180"
        MinHeight="740"
        MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="LightButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#E0F2FE"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="112"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F172A" Offset="0"/>
                    <GradientStop Color="#1D4ED8" Offset="0.55"/>
                    <GradientStop Color="#06B6D4" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="68"
                            Height="68"
                            CornerRadius="18"
                            Background="White"
                            Padding="7"
                            VerticalAlignment="Center">
                        <Image x:Name="HeaderLogoImage"
                               Stretch="Uniform"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="14,0,0,0">
                        <TextBlock Text="ALGIA Cabinet Launcher"
                                   Foreground="White"
                                   FontSize="30"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Assistant d'installation, diagnostic et mise en route"
                                   Foreground="#DBEAFE"
                                   FontSize="15"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Column="1"
                        Background="#1E293B"
                        CornerRadius="14"
                        Padding="14"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Package"
                                   Foreground="#93C5FD"
                                   FontSize="12"/>
                        <TextBlock x:Name="VersionText"
                                   Text="v0.1.8"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="315"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Actions"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,0,0,14"/>

                        <Button Content="Vérifier la machine" Click="CheckMachine_Click"/>
                        <Button Content="Choisir le dossier" Click="ChooseFolder_Click" Style="{StaticResource LightButton}"/>
                        <Button Content="Installer ALGIA Cabinet" Click="Install_Click"/>
                        <Button Content="Démarrer" Click="Start_Click" Style="{StaticResource SecondaryButton}"/>
                        <Button Content="Arrêter" Click="Stop_Click" Background="#DC2626" Foreground="White"/>
                        <Button Content="Sauvegarder" Click="Backup_Click"/>
                        <Button Content="Restaurer" Click="Restore_Click"/>
                        <Button Content="Mettre à jour" Click="Update_Click"/>
                        <Button Content="Ouvrir ALGIA Cabinet" Click="OpenApp_Click" Style="{StaticResource LightButton}"/>
                        <Button Content="Administration" Click="Admin_Click" Style="{StaticResource LightButton}"/>
                        <Button Content="Voir les journaux" Click="Logs_Click" Style="{StaticResource LightButton}"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                        <TextBlock Text="Dossier d’installation ALGIA Cabinet"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,12,0,4"/>
                        <Border Background="#F1F5F9" CornerRadius="10" Padding="10">
                            <TextBlock x:Name="RootText"
                                       TextWrapping="Wrap"
                                       Foreground="#0F172A"
                                       FontWeight="SemiBold"
                                       FontSize="12"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="État" Foreground="#6B7280" FontSize="12"/>
                            <TextBlock x:Name="StatusText"
                                       Text="Initialisation"
                                       Foreground="#2563EB"
                                       FontWeight="Bold"
                                       FontSize="17"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Docker" Foreground="#6B7280" FontSize="12"/>
                            <TextBlock x:Name="DockerText"
                                       Text="Non vérifié"
                                       Foreground="#111827"
                                       FontWeight="SemiBold"
                                       FontSize="17"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Compose" Foreground="#6B7280" FontSize="12"/>
                            <TextBlock x:Name="ComposeText"
                                       Text="Non vérifié"
                                       Foreground="#111827"
                                       FontWeight="SemiBold"
                                       FontSize="17"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Port" Foreground="#6B7280" FontSize="12"/>
                            <TextBlock x:Name="PortText"
                                       Text="8080"
                                       Foreground="#111827"
                                       FontWeight="SemiBold"
                                       FontSize="17"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Installation"
                                       Foreground="#6B7280"
                                       FontSize="12"/>
                            <TextBlock x:Name="InstallFolderText"
                                       Text="Non sélectionné"
                                       TextWrapping="Wrap"
                                       Foreground="#0F172A"
                                       FontWeight="Bold"
                                       FontSize="14"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Accès administrateur initial"
                                       Foreground="#6B7280"
                                       FontSize="12"/>
                            <TextBlock x:Name="AdminPasswordText"
                                       Text="Mot de passe temporaire : non créé"
                                       TextWrapping="Wrap"
                                       Foreground="#0F172A"
                                       FontWeight="Bold"
                                       FontSize="14"/>
                            <TextBlock Text="À changer après le premier lancement dans Administration."
                                       TextWrapping="Wrap"
                                       Foreground="#DC2626"
                                       FontSize="12"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Journal d'exécution"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#111827"
                                       DockPanel.Dock="Left"/>
                            <TextBlock x:Name="ImageText"
                                       Text="Image : algiadata/algia-cabinet:v0.1.8"
                                       Foreground="#6B7280"
                                       HorizontalAlignment="Right"
                                       DockPanel.Dock="Right"/>
                        </DockPanel>

                        <TextBox Grid.Row="1"
                                 x:Name="LogBox"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Background="#020617"
                                 Foreground="#CFFAFE"
                                 BorderBrush="#111827"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 Padding="14"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#E5E7EB">
            <TextBlock Text="ALGIA Cabinet - Installation locale Docker"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="#4B5563"/>
        </Border>
    </Grid>
</Window>









